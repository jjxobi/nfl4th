---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Coach Tendencies | NFL 4th Down Predictor" description="Browse every NFL head coach's real 4th down tendency, ranked by aggression.">
  <div class="coach-page-head">
    <h1>Coach Tendencies</h1>
    <p class="coach-lede">Click a column to sort. Click a coach to see their full profile.</p>
    <p class="coach-summary" id="coach-summary" aria-live="polite">Loading coach data&hellip;</p>
  </div>

  <div class="coach-table-wrap">
    <table id="coach-table">
      <caption class="sr-only">Sortable table of every NFL head coach's real 4th down tendency rates</caption>
      <thead>
        <tr>
          <th data-sort="coach" tabindex="0" scope="col">Coach<span class="sort-arrow" aria-hidden="true"></span></th>
          <th data-sort="n_decisions" tabindex="0" scope="col" class="num">Decisions<span class="sort-arrow" aria-hidden="true"></span></th>
          <th data-sort="go_for_it" tabindex="0" scope="col" class="num">Go For It<span class="sort-arrow" aria-hidden="true"></span></th>
          <th data-sort="punt" tabindex="0" scope="col" class="num">Punt<span class="sort-arrow" aria-hidden="true"></span></th>
          <th data-sort="field_goal" tabindex="0" scope="col" class="num">Field Goal<span class="sort-arrow" aria-hidden="true"></span></th>
        </tr>
      </thead>
      <tbody id="coach-table-body">
        <tr class="table-message-row"><td colspan="5">Loading coaches&hellip;</td></tr>
      </tbody>
    </table>
  </div>

  <div id="coach-detail" hidden aria-live="polite"></div>
</Layout>

<script>
  import { getCoaches, type CoachProfile, type DecisionRates } from "../lib/api";

  let coaches: CoachProfile[] = [];
  let sortKey = "go_for_it";
  let sortDescending = true;

  const columnLabels: Record<string, string> = {
    coach: "coach name",
    n_decisions: "decisions",
    go_for_it: "go for it rate",
    punt: "punt rate",
    field_goal: "field goal rate",
  };

  function sortValue(coach: CoachProfile, key: string): number | string {
    if (key === "coach") return coach.coach;
    if (key === "n_decisions") return coach.n_decisions;
    if (key === "go_for_it") return coach.go_for_it.shrunk;
    if (key === "punt") return coach.punt.shrunk;
    if (key === "field_goal") return coach.field_goal.shrunk;
    return "";
  }

  function sortedCoaches(): CoachProfile[] {
    return [...coaches].sort((a, b) => {
      const av = sortValue(a, sortKey);
      const bv = sortValue(b, sortKey);
      const cmp = av < bv ? -1 : av > bv ? 1 : 0;
      return sortDescending ? -cmp : cmp;
    });
  }

  function updateSortIndicators() {
    document.querySelectorAll<HTMLElement>("th[data-sort]").forEach((th) => {
      const key = th.dataset.sort!;
      const active = key === sortKey;
      th.classList.toggle("active-sort", active);
      th.setAttribute("aria-sort", active ? (sortDescending ? "descending" : "ascending") : "none");
    });
  }

  function updateSummary() {
    const summary = document.getElementById("coach-summary")!;
    const direction = sortDescending ? "highest to lowest" : "lowest to highest";
    summary.textContent = `${coaches.length} coaches on file, sorted by ${columnLabels[sortKey]}, ${direction}.`;
  }

  function selectRow(row: HTMLTableRowElement, coach: CoachProfile) {
    document.querySelectorAll("#coach-table-body tr.selected").forEach((r) => r.classList.remove("selected"));
    row.classList.add("selected");
    showDetail(coach);
  }

  function render() {
    const body = document.getElementById("coach-table-body")!;
    body.innerHTML = "";
    for (const coach of sortedCoaches()) {
      const row = document.createElement("tr");
      row.tabIndex = 0;
      row.innerHTML = `
        <td>${coach.coach}</td>
        <td class="num">${coach.n_decisions.toLocaleString()}</td>
        <td class="num">${(coach.go_for_it.shrunk * 100).toFixed(1)}%</td>
        <td class="num">${(coach.punt.shrunk * 100).toFixed(1)}%</td>
        <td class="num">${(coach.field_goal.shrunk * 100).toFixed(1)}%</td>
      `;
      row.addEventListener("click", () => selectRow(row, coach));
      row.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          selectRow(row, coach);
        }
      });
      body.appendChild(row);
    }

    updateSortIndicators();
    updateSummary();
  }

  function statBlock(label: string, rates: DecisionRates): string {
    const shrunkPct = rates.shrunk * 100;
    const observedPct = rates.observed * 100;
    const expectedPct = rates.expected * 100;
    return `
      <div class="stat-block">
        <div class="stat-block-head">
          <span class="stat-label">${label}</span>
          <span class="stat-value">${shrunkPct.toFixed(1)}%</span>
        </div>
        <div class="stat-bar">
          <span class="stat-bar-fill" style="width: ${shrunkPct}%"></span>
          <span class="stat-bar-marker" style="left: ${expectedPct}%"></span>
        </div>
        <p class="stat-footnote">Observed ${observedPct.toFixed(1)}% &middot; situational baseline ${expectedPct.toFixed(1)}%</p>
      </div>
    `;
  }

  function showDetail(coach: CoachProfile) {
    const detail = document.getElementById("coach-detail")!;
    detail.hidden = false;
    detail.innerHTML = `
      <div class="detail-head">
        <h2>${coach.coach}</h2>
        <p class="detail-meta">${coach.n_decisions.toLocaleString()} career 4th down decisions logged</p>
      </div>
      <div class="stat-grid">
        ${statBlock("Go For It", coach.go_for_it)}
        ${statBlock("Field Goal", coach.field_goal)}
        ${statBlock("Punt", coach.punt)}
      </div>
      <p class="detail-note">The bar is this coach's real rate, shrunk toward the baseline to account for career sample size. The marker is the situational baseline: what a league-average coach would do given the same mix of down, distance, and score.</p>
    `;
    detail.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function toggleSort(key: string) {
    if (sortKey === key) {
      sortDescending = !sortDescending;
    } else {
      sortKey = key;
      sortDescending = true;
    }
    render();
  }

  document.querySelectorAll<HTMLElement>("th[data-sort]").forEach((th) => {
    th.addEventListener("click", () => toggleSort(th.dataset.sort!));
    th.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggleSort(th.dataset.sort!);
      }
    });
  });

  updateSortIndicators();

  getCoaches()
    .then((data) => {
      coaches = data;
      render();
    })
    .catch((error) => {
      const body = document.getElementById("coach-table-body")!;
      body.innerHTML = `<tr class="table-message-row"><td colspan="5">Could not load coaches: ${error instanceof Error ? error.message : "unknown error"}</td></tr>`;
      const summary = document.getElementById("coach-summary")!;
      summary.textContent = "Coach data is unavailable right now.";
    });
</script>

<style is:global>
  .coach-page-head {
    margin-bottom: var(--space-5);
  }

  .coach-lede {
    margin-bottom: var(--space-2);
  }

  .coach-summary {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-2);
    margin: 0;
  }

  .coach-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-surface);
  }

  #coach-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    font-variant-numeric: tabular-nums;
  }

  #coach-table thead th {
    text-align: left;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    background: var(--color-surface-raised);
    border-bottom: 2px dashed var(--color-line);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  #coach-table thead th:hover {
    color: var(--color-text);
  }

  #coach-table thead th.active-sort {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  #coach-table thead th.num,
  #coach-table td.num {
    text-align: right;
  }

  .sort-arrow {
    display: inline-block;
    width: 0.9em;
    margin-left: 0.35em;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  th.active-sort .sort-arrow {
    opacity: 1;
  }

  th.active-sort[aria-sort="descending"] .sort-arrow::before {
    content: "\25BC";
  }

  th.active-sort[aria-sort="ascending"] .sort-arrow::before {
    content: "\25B2";
  }

  #coach-table-body tr {
    cursor: pointer;
  }

  #coach-table-body tr:hover td {
    background: var(--color-surface-raised);
  }

  #coach-table-body tr.selected td {
    background: var(--color-surface-raised);
  }

  #coach-table-body tr.selected td:first-child {
    box-shadow: inset 3px 0 0 var(--color-accent);
  }

  #coach-table-body td {
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-line);
    font-size: 0.92rem;
    transition: background-color 0.12s ease;
  }

  #coach-table-body td:first-child {
    font-weight: 500;
  }

  #coach-table-body td.num {
    font-family: var(--font-mono);
    color: var(--color-text-dim);
  }

  #coach-table-body tr:last-child td {
    border-bottom: none;
  }

  .table-message-row td {
    text-align: center;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: var(--space-5);
  }

  #coach-detail {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 4px;
  }

  .detail-head {
    margin-bottom: var(--space-4);
  }

  .detail-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-dim);
    margin: 0;
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .stat-block {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: var(--space-3);
  }

  .stat-block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .stat-bar {
    position: relative;
    height: 6px;
    background: var(--color-line);
    border-radius: 3px;
    margin: var(--space-3) 0 var(--space-2);
  }

  .stat-bar-fill {
    display: block;
    height: 100%;
    background: var(--color-accent);
    border-radius: 3px;
  }

  .stat-bar-marker {
    position: absolute;
    top: -3px;
    width: 2px;
    height: 12px;
    background: var(--color-accent-2);
    transform: translateX(-1px);
  }

  .stat-footnote {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-dim);
    margin: 0;
    max-width: none;
  }

  .detail-note {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-dim);
    max-width: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 40rem) {
    .stat-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #coach-table thead th,
    #coach-table-body td,
    .sort-arrow {
      transition: none;
    }
  }
</style>
